{
  "entities": {
    "WaitlistEntry": {
      "title": "Waitlist Entry",
      "description": "Represents a user joining the waitlist",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "The email address of the user"
        },
        "createdAt": {
          "type": "timestamp"
        }
      },
      "required": ["email", "createdAt"]
    }
  },
  "firestore": {
    "waitlist/{entryId}": {
      "schema": {
        "$ref": "#/entities/WaitlistEntry"
      },
      "description": "Stores all waitlist signups"
    }
  }
}
